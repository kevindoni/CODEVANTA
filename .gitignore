# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Generated analysis output
samples/report_*.json
# ...except the two report fixtures the docs reference; keep them tracked.
!samples/report_elf64.json
!samples/report_notepad.json
!samples/report_bundle.json
*.log

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

!samples/gdb_trace.log

# Scratch scripts never belong at the repo root (repo Python lives in src/tests/scripts)
/*.py

# Ghidra analysis projects are caches; CODEVANTA points them at the temp dir,
# and a stray nested "<binary>_ghidra" (older pyghidra default) must not land in git
*_ghidra/

# Benchmark outputs are regenerated by bench/run_codevanta.py
bench/results/*
!bench/results/.gitkeep
